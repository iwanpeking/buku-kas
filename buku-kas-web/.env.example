# Isi dengan data dari Supabase (Project Settings -> API), lalu rename file
# ini jadi ".env" kalau mau coba jalankan di laptop (npm run dev).
# Untuk deploy ke Vercel, isi ini di menu "Environment Variables" Vercel,
# BUKAN lewat file ini.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini
